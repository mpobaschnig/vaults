<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="MissingLibsWindow" parent="AdwDialog">
    <property name="height-request">280</property>
    <property name="width-request">320</property>
    <property name="content-height">480</property>
    <property name="content-width">360</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwStatusPage" id="status_page">
            <property name="icon_name">info-outline-symbolic</property>
            <property name="title" translatable="yes">Missing dependencies</property>
            <property name="description" translatable="yes">You are probably missing fuse2 on your host to use CryFS.</property>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwSwitchRow" id="dont_show_again_switch_row">
                    <property name="title" translatable="yes">Don't show again</property>
                  </object>
                </child>
                <child>
                  <object class="AdwButtonRow" id="more_info_button_row">
                    <property name="title" translatable="yes">More information</property>
                    <property name="end-icon-name">go-next-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
