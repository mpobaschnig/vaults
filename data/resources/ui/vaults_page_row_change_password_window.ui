<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="VaultsPageRowChangePasswordWindow" parent="AdwDialog">
    <property name="height-request">340</property>
    <property name="width-request">320</property>
    <property name="content-height">560</property>
    <property name="content-width">360</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwStatusPage" id="status_page">
            <property name="icon_name">system-lock-screen-symbolic</property>
            <property name="title" translatable="yes">Change Password</property>
            <property name="description" translatable="yes">Enter the old and new password for the Vault.</property>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwPasswordEntryRow" id="old_password_entry_row">
                    <property name="title" translatable="yes">Old Password</property>
                    <child type="suffix">
                      <object class="GtkButton" id="change_button">
                        <property name="valign">center</property>
                        <property name="halign">center</property>
                        <property name="icon_name">changes-allow-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Change Password</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPasswordEntryRow" id="new_password_entry_row">
                    <property name="title" translatable="yes">New Password</property>
                    <property name="activates-default">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="password_change_note">
                    <property name="margin-top">12</property>
                    <property name="wrap">true</property>
                    <property name="label" translatable="yes">Note: Changing the password re-encrypts the gocryptfs config file. If the previous config file or master key has been compromised, changing the password will not improve security.</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
