#!/bin/sh
# Source: https://gitlab.gnome.org/GNOME/fractal/blob/master/hooks/pre-commit.hook

if ! which cargo &> /dev/null || ! cargo fmt --help &> /dev/null; then
    echo "Unable to check the code style, because rustfmt could not be run."
    echo "Install rustfmt via your distribution's package manager or rustup"
    echo "(see https://rust-lang.org/tools/install) and commit again."

    if [ ! -t 1 ]; then
        # No input is possible
        echo "Performing commit."
        exit 0
    fi

    echo ""
    echo "n: Don't install rustfmt and perform the commit"
    echo "Q: Don't install rustfmt and abort the commit"

    while true; do
        read -p "Perform the commit without style checking? [n/Q]: " yn
        case $yn in
            [Nn]* ) echo "Performing commit."; exit 0;;
            [Qq]* | "" ) echo "Aborting commit."; exit 1;;
            * ) echo "Invalid input";;
        esac
    done
fi

echo "--Checking style--"
cargo fmt --all -- --check
if test $? != 0; then
    echo "--Checking style fail--"
    echo "Please fix the above issues, either manually or by running: cargo fmt --all"

    exit 1
else
    echo "--Checking style pass--"
fi
